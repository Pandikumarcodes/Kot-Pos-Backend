# Required at startup
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/Kot-Pos
JWT_SECRET=<replace-with-at-least-16-characters>
REFRESH_TOKEN_SECRET=<replace-with-a-different-16-character-secret>

# Browser/API origins and runtime behavior
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
MONGO_TIMEOUT_MS=10000
MONGO_TIMEOUT=10000
SLOW_REQUEST_MS=1000

# Google Gemini (optional; required only for live Gemini responses)
GEMINI_API_KEY=<your-gemini-api-key>

# Redis cache and shared rate limiting (optional)
REDIS_URL=redis://localhost:6379
CACHE_TTL=300
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_OPERATION_TIMEOUT_MS=500
REDIS_TIMEOUT=500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=200

# BullMQ and background jobs (optional)
ENABLE_BACKGROUND_JOBS=false
QUEUE_CONCURRENCY=1
QUEUE_RETRY_ATTEMPTS=5
QUEUE_RETRY_DELAY_MS=1000
QUEUE_COMPLETED_RETENTION_SECONDS=86400
DAILY_REPORT_RECIPIENTS=<comma-separated-recipient-addresses>
EMAIL_WEBHOOK_URL=https://example.com/email-webhook

# Production Swagger Basic authentication (optional)
DOCS_USERNAME=<documentation-username>
DOCS_PASSWORD=<documentation-password>

# Development/test only
E2E_TESTING=false
SEED_ADMIN_PASSWORD=<development-demo-password>
